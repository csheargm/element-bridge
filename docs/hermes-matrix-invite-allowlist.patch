diff -ruN a/tests/gateway/test_matrix_invite_allowlist.py b/tests/gateway/test_matrix_invite_allowlist.py
--- a/tests/gateway/test_matrix_invite_allowlist.py
+++ b/tests/gateway/test_matrix_invite_allowlist.py
@@ -0,0 +1,108 @@
+"""Matrix invites: with MATRIX_ALLOWED_USERS set, only allowed users can pull the bot into a room."""
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import PlatformConfig
+
+
+def _make_adapter(monkeypatch, allowed=None):
+    from plugins.platforms.matrix.adapter import MatrixAdapter
+
+    if allowed is None:
+        monkeypatch.delenv("MATRIX_ALLOWED_USERS", raising=False)
+    else:
+        monkeypatch.setenv("MATRIX_ALLOWED_USERS", allowed)
+    config = PlatformConfig(enabled=True, token="syt_test_token",
+                            extra={"homeserver": "https://matrix.example.org",
+                                   "user_id": "@hermes:example.org"})
+    adapter = MatrixAdapter(config)
+    joined = []
+
+    async def fake_join(room_id):
+        joined.append(room_id)
+        return True
+
+    adapter._join_room_by_id = fake_join
+    return adapter, joined
+
+
+def _invite(sender, room_id="!room:example.org"):
+    return SimpleNamespace(room_id=room_id, sender=sender, content=None)
+
+
+@pytest.mark.asyncio
+async def test_no_allowlist_joins_any_invite(monkeypatch):
+    adapter, joined = _make_adapter(monkeypatch)
+    await adapter._on_invite(_invite("@stranger:example.org"))
+    assert joined == ["!room:example.org"]
+
+
+@pytest.mark.asyncio
+async def test_allowlisted_inviter_is_joined(monkeypatch):
+    adapter, joined = _make_adapter(monkeypatch, "@owner:example.org, @pm:example.org")
+    await adapter._on_invite(_invite("@pm:example.org"))
+    assert joined == ["!room:example.org"]
+
+
+@pytest.mark.asyncio
+async def test_other_inviter_is_ignored(monkeypatch):
+    adapter, joined = _make_adapter(monkeypatch, "@owner:example.org,@pm:example.org")
+    await adapter._on_invite(_invite("@stranger:example.org"))
+    assert joined == []
+
+
+@pytest.mark.asyncio
+async def test_missing_sender_is_ignored_when_allowlisted(monkeypatch):
+    adapter, joined = _make_adapter(monkeypatch, "@owner:example.org")
+    await adapter._on_invite(SimpleNamespace(room_id="!room:example.org", content=None))
+    assert joined == []
+
+
+@pytest.mark.asyncio
+async def test_wildcard_allowlist_joins_any_invite(monkeypatch):
+    adapter, joined = _make_adapter(monkeypatch, "*")
+    await adapter._on_invite(_invite("@stranger:example.org"))
+    assert joined == ["!room:example.org"]
+
+
+def _sync_with_invite(sender, room_id="!pending:example.org", target="@hermes:example.org"):
+    member = {"type": "m.room.member", "state_key": target, "sender": sender,
+              "content": {"membership": "invite"}}
+    noise = {"type": "m.room.name", "state_key": "", "sender": "@x:example.org",
+             "content": {"name": "Room"}}
+    return {"rooms": {"invite": {room_id: {"invite_state": {"events": [noise, member]}}}}}
+
+
+@pytest.mark.asyncio
+async def test_sync_reconcile_ignores_other_inviter(monkeypatch):
+    # The sync reconciliation path joins from rooms.invite without calling _on_invite.
+    adapter, joined = _make_adapter(monkeypatch, "@owner:example.org")
+    await adapter._join_pending_invites(_sync_with_invite("@stranger:example.org"))
+    assert joined == []
+
+
+@pytest.mark.asyncio
+async def test_sync_reconcile_joins_allowlisted_inviter(monkeypatch):
+    adapter, joined = _make_adapter(monkeypatch, "@owner:example.org")
+    await adapter._join_pending_invites(_sync_with_invite("@owner:example.org"))
+    assert joined == ["!pending:example.org"]
+
+
+@pytest.mark.asyncio
+async def test_sync_reconcile_ignores_invite_for_someone_else(monkeypatch):
+    # An allowed user's invite of a different user is not the invite of the bot.
+    adapter, joined = _make_adapter(monkeypatch, "@owner:example.org")
+    await adapter._join_pending_invites(
+        _sync_with_invite("@owner:example.org", target="@other:example.org"))
+    assert joined == []
+
+
+@pytest.mark.asyncio
+async def test_sync_reconcile_without_invite_state(monkeypatch):
+    adapter, joined = _make_adapter(monkeypatch, "@owner:example.org")
+    await adapter._join_pending_invites({"rooms": {"invite": {"!bare:example.org": {}}}})
+    assert joined == []
+    open_adapter, open_joined = _make_adapter(monkeypatch)
+    await open_adapter._join_pending_invites({"rooms": {"invite": {"!bare:example.org": {}}}})
+    assert open_joined == ["!bare:example.org"]
