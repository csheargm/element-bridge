+    def _invite_allowed(self, room_id: str, inviter: str) -> bool:
+        """With MATRIX_ALLOWED_USERS set, only those users may pull the bot into a
+        room; otherwise anyone could invite it and have it read their room. No list
+        (or "*") keeps the open behaviour. An unknown inviter fails a restrictive list."""
+        allowed = self._allowed_user_ids
+        if not allowed or "*" in allowed or (inviter and inviter in allowed):
+            return True
+        logger.info(
+            "Matrix: ignoring invite to %s from %s (not in MATRIX_ALLOWED_USERS)",
+            room_id,
+            inviter or "an unknown sender",
+        )
+        return False
+
+    def _pending_inviter(self, room_data: Any) -> str:
+        """Sender of the m.room.member invite for us in a sync rooms.invite entry ("" if none)."""
+        state = room_data.get("invite_state", {}) if isinstance(room_data, dict) else {}
+        events = state.get("events", []) if isinstance(state, dict) else []
+        for ev in events if isinstance(events, list) else []:
+            if not isinstance(ev, dict) or ev.get("type") != "m.room.member":
+                continue
+            content = ev.get("content") if isinstance(ev.get("content"), dict) else {}
+            if ev.get("state_key") == self._user_id and content.get("membership") == "invite":
+                return str(ev.get("sender") or "")
+        return ""
+
