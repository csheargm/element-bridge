@@ -0,0 +1,82 @@
+"""Matrix reply_to_mode: whether replies quote the message they answer (m.in_reply_to)."""
+import os
+from unittest.mock import patch
+
+import pytest
+
+from gateway.config import PlatformConfig
+
+
+def _make_adapter(**extra):
+    from plugins.platforms.matrix.adapter import MatrixAdapter
+
+    config = PlatformConfig(enabled=True, token="syt_test_token",
+                            extra={"homeserver": "https://matrix.example.org",
+                                   "user_id": "@hermes:example.org", **extra})
+    return MatrixAdapter(config)
+
+
+def _relation(adapter, chunk_index=0, thread_id=None):
+    content = {}
+    adapter._apply_relation_metadata(content, reply_to="$question",
+                                     metadata={"thread_id": thread_id} if thread_id else None,
+                                     chunk_index=chunk_index)
+    return content.get("m.relates_to")
+
+
+def test_default_quotes_every_chunk_as_before(monkeypatch):
+    monkeypatch.delenv("MATRIX_REPLY_TO_MODE", raising=False)
+    adapter = _make_adapter()
+    assert _relation(adapter, 0) == {"m.in_reply_to": {"event_id": "$question"}}
+    assert _relation(adapter, 1) == {"m.in_reply_to": {"event_id": "$question"}}
+
+
+def test_off_never_quotes():
+    adapter = _make_adapter(reply_to_mode="off")
+    assert _relation(adapter, 0) is None
+    assert _relation(adapter, 3) is None
+
+
+def test_off_keeps_the_thread():
+    adapter = _make_adapter(reply_to_mode="off")
+    rel = _relation(adapter, 0, thread_id="$root")
+    assert rel["rel_type"] == "m.thread" and rel["event_id"] == "$root"
+    assert rel["m.in_reply_to"] == {"event_id": "$root"}   # spec fallback to the root, not the question
+
+
+def test_first_quotes_only_the_first_chunk():
+    adapter = _make_adapter(reply_to_mode="first")
+    assert _relation(adapter, 0) == {"m.in_reply_to": {"event_id": "$question"}}
+    assert _relation(adapter, 1) is None
+
+
+def test_yaml_false_and_env_and_unknown(monkeypatch):
+    assert _make_adapter(reply_to_mode=False)._reply_to_mode == "off"
+    assert _make_adapter(reply_to_mode="bogus")._reply_to_mode == "all"
+    monkeypatch.setenv("MATRIX_REPLY_TO_MODE", "first")
+    assert _make_adapter()._reply_to_mode == "first"
+
+
+def test_yaml_key_becomes_env(monkeypatch):
+    from plugins.platforms.matrix.adapter import _apply_yaml_config
+
+    monkeypatch.delenv("MATRIX_REPLY_TO_MODE", raising=False)
+    with patch.dict(os.environ, {}, clear=False):
+        _apply_yaml_config({}, {"reply_to_mode": False})
+        assert os.environ["MATRIX_REPLY_TO_MODE"] == "off"
+
+
+@pytest.mark.asyncio
+async def test_send_passes_the_chunk_index(monkeypatch):
+    adapter = _make_adapter(reply_to_mode="first")
+    seen = []
+    monkeypatch.setattr(adapter, "_apply_relation_metadata",
+                        lambda content, **kw: seen.append(kw.get("chunk_index")))
+    monkeypatch.setattr(adapter, "truncate_message", lambda text, limit: ["a", "b"])
+
+    class Client:
+        async def send_message_event(self, *a, **k):
+            return "$e"
+    adapter._client = Client()
+    await adapter.send("!r:example.org", "hello", reply_to="$question")
+    assert seen == [0, 1]
