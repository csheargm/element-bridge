# envfile.py copies this to .env (mode 600) on the VM and fills the secrets; never commit .env.
# Plain NAME=value lines only: no quotes, no $, no spaces (it is data, not a shell script).
# Image versions are pinned in docker-compose.yml (deployed with the commit), not here.
ROOMS_DOMAIN=rooms.hagencylabs.xyz
MATRIX_DOMAIN=matrix.hagencylabs.xyz
# Synapse Admin: proxied by Cloudflare, behind Cloudflare Access (the Caddyfile accepts only Cloudflare).
ADMIN_DOMAIN=admin.hagencylabs.xyz
# PERMANENT: every user ID ends with this (@anna:matrix.hagencylabs.xyz). Change it only before the
# first start. "hagencylabs.xyz" works too, once the apex serves /.well-known/matrix/server.
SERVER_NAME=matrix.hagencylabs.xyz
# Your account's name (e.g. anna for @anna:matrix.hagencylabs.xyz): guard.py's disk/traffic warnings
# go to you from @pm. Empty: they only go to the journal (journalctl -u hagency-guard).
OPERATOR=
# Filled by envfile.py with a random value. Changing it after the first start needs ALTER ROLE too.
POSTGRES_PASSWORD=
# @pm's read-only GitHub App (docs/GITHUB_APP.md): its App ID once registered, and its slug (the
# name in github.com/apps/<slug>). The private key goes in ~/hagency/app/deploy/secrets/github-app.pem
# (mode 600), never here. Empty: @pm doesn't read GitHub on this server.
GITHUB_APP_ID=
GITHUB_APP_SLUG=hagency-rooms
# The App's Client ID (starts with Iv; public, NOT the client secret): people prove which GitHub account
# is theirs with "Connect GitHub" (tick Enable Device Flow on the App first). Empty: nobody can bind a repo.
GITHUB_APP_CLIENT_ID=
# Optional: only these repos may be chosen (owner/name, comma-separated, no spaces). Empty: any repo that
# has the App installed and that the asker's connected GitHub account can write to (docs/GITHUB_APP.md).
HAGENCY_REPOS=
