# Copy to local.env (git-ignored) and set this server's repos. start.sh loads it.
# Never put passwords or tokens here: every agent process sees these values.
LOOP_REPO=you/hagency-demo-sandbox
HAGENCY_REPOS="you/hagency-hello"
# Only if you own every account whose agent runs on this computer: lets "Use it myself" run
# someone's own version here (it runs as this computer's account, with every agent's passwords).
# HAGENCY_CUSTOM_SHARED_OK=1
